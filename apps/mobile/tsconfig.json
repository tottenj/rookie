{
  "extends": ["expo/tsconfig.base", "@rookie/tsconfig/react"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts", "src/uniwind-types.d.ts"]
}
