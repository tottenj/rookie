{
  "name": "@rookie/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit": "jest --config ./jest.config.cjs --selectProjects api-unit --passWithNoTests",
    "test:watch": "jest --config ./jest.config.cjs --selectProjects api-unit --watch",
    "test:cov": "jest --config ./jest.config.cjs --selectProjects api-unit --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest.config.cjs --selectProjects api-unit --runInBand",
    "test:integration": "jest --config ./jest.config.cjs --selectProjects api-integration --passWithNoTests",
    "test:integration:setup": "docker compose -f ./compose.test.yaml up -d --wait",
    "test:integration:teardown": "docker compose -f ./compose.test.yaml down -v",
    "test:integration:ci": "npm run test:integration:setup && npm run test:integration && npm run test:integration:teardown",
    "test:all": "jest --config ./jest.config.cjs",
    "db:dev:up": "docker compose -f ./compose.yaml up -d --wait",
    "db:dev:down": "docker compose -f ./compose.yaml down -v",
    "db:test:up": "docker compose -f ./compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f ./compose.test.yaml down -v",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@rookie/shared-types": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@rookie/eslint-config": "workspace:*",
    "@rookie/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  }
}