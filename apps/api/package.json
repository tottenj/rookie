{
  "name": "@rookie/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:e2e": "nest start",
    "dev": "dotenv -e .env.dev -- nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest --config ./jest.config.cjs --selectProjects api-unit --passWithNoTests",
    "test:watch": "jest --config ./jest.config.cjs --selectProjects api-unit --watch",
    "test:cov": "jest --config ./jest.config.cjs --selectProjects api-unit --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest.config.cjs --selectProjects api-unit --runInBand",
    "test:integration": "tsx test/scripts/run-integration-tests.ts",
    "test:integration:ci": "tsx test/scripts/run-integration-tests.ts --ci",
    "test:integration:run": "jest --config ./jest.config.cjs --selectProjects api-integration --passWithNoTests",
    "test:api": "tsx test/scripts/run-api-tests.ts",
    "test:api:ci": "tsx test/scripts/run-api-tests.ts --ci",
    "test:e2e:database:setup": "tsx test/e2e/setup-e2e-database.ts",
    "test:e2e:firebase:setup": "tsx test/e2e/setup-e2e-firebase.ts",
    "test:e2e:environment:setup": "tsx test/e2e/setup-e2e-environment.ts",
    "test:api:run": "jest --config ./jest.config.cjs --selectProjects api-api --passWithNoTests",
    "test:integration:setup": "docker compose -f ./compose.test.yaml up -d --wait",
    "test:integration:teardown": "docker compose -f ./compose.test.yaml down -v",
    "test:all": "jest --config ./jest.config.cjs",
    "test": "jest --config ./jest.config.cjs --selectProjects api-unit --passWithNoTests",
    "db:dev:up": "docker compose -f ./compose.yaml up -d --wait",
    "db:dev:stop": "docker compose -f ./compose.yaml stop",
    "db:dev:down": "docker compose -f ./compose.yaml down",
    "db:dev:reset": "docker compose -f ./compose.yaml down -v && docker compose -f ./compose.yaml up -d --wait",
    "db:test:up": "docker compose -f ./compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f ./compose.test.yaml down -v",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:generate:dev": "dotenv -e .env.dev -- prisma generate",
    "prisma:migrate:dev:dev": "dotenv -e .env.dev -- prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.1",
    "@rookie/shared-types": "workspace:*",
    "firebase-admin": "^12.7.0",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@rookie/eslint-config": "workspace:*",
    "@rookie/test-fixtures": "workspace:*",
    "@rookie/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  }
}
