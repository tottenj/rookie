{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"]
    },
    "test:integration": {
      "dependsOn": ["^test:integration"]
    },
    "test:integration:api:ci": {
      "cache": false
    },
    "db:api:dev:up": {
      "cache": false
    },
    "db:api:dev:down": {
      "cache": false
    },
    "db:api:test:up": {
      "cache": false
    },
    "db:api:test:down": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    } 
  }
}
