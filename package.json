{
  "name": "rookie",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:integration:api": "pnpm --filter @rookie/api run test:integration",
    "test:integration:api:ci": "pnpm --filter @rookie/api run test:integration:ci",
    "db:api:dev:up": "pnpm --filter @rookie/api run db:dev:up",
    "db:api:dev:down": "pnpm --filter @rookie/api run db:dev:down",
    "db:api:test:up": "pnpm --filter @rookie/api run db:test:up",
    "db:api:test:down": "pnpm --filter @rookie/api run db:test:down",
    "typecheck": "turbo run typecheck"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "eslint": "^9.39.4",
    "turbo": "^2.10.3"
  }
}
