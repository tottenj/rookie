{
  "name": "rookie",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "sh -c 'trap \"pnpm run db:api:dev:down >/dev/null 2>&1 || true\" EXIT INT TERM; node ./scripts/dev.mjs'",
    "dev:apps": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:integration:api": "pnpm --filter @rookie/api run test:integration",
    "test:integration:api:ci": "pnpm --filter @rookie/api run test:integration:ci",
    "db:api:dev:up": "pnpm --filter @rookie/api run db:dev:up",
    "db:api:dev:up:attached": "pnpm run db:api:dev:up",
    "db:api:dev:down": "pnpm --filter @rookie/api run db:dev:down",
    "db:api:test:up": "pnpm --filter @rookie/api run db:test:up",
    "db:api:test:down": "pnpm --filter @rookie/api run db:test:down",
    "firebase": "firebase",
    "emulators": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 firebase emulators:start",
    "emulators:persist": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 firebase emulators:start --import=firebase/data --export-on-exit",
    "prisma:generate": "pnpm --filter @rookie/api run prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @rookie/api run prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @rookie/api run prisma:migrate:deploy",
    "prisma:migrate:reset": "pnpm --filter @rookie/api run prisma:migrate:reset",
    "prisma:studio": "pnpm --filter @rookie/api run prisma:studio",
    "prisma:generate:dev": "pnpm --filter @rookie/api run prisma:generate:dev",
    "prisma:migrate:dev:dev": "pnpm --filter @rookie/api run prisma:migrate:dev:dev"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "firebase-tools": "^15.23.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.3"
  }
}
